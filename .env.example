# DocTheCode needs no configuration: everything is set up in the browser.
# These variables are all optional overrides (see README → Self-host DocTheCode → Optional settings).

# DOCTHECODE_PUBLIC_URL=https://docs.example.com
# DOCTHECODE_SECRET_KEY=           # default: generated into the data directory
# DATABASE_URL=postgresql://user:pass@db.internal/docthecode   # default: built-in SQLite
# DOCTHECODE_DATA_DIR=./data
# DOCTHECODE_BACKUP_DIR=/backup
# DOCTHECODE_SETUP_TOKEN=
# DOCTHECODE_TELEMETRY=off
